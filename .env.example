APP_NAME="EuroMedStudy"
APP_ENV=production
APP_KEY=base64:CHANGE_THIS_RUN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ===== ADMIN CREDENTIALS =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
ADMIN_EMAIL=admin@yourdomain.com

# ===== DATABASE =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===== SESSION =====
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ===== CACHE =====
CACHE_DRIVER=file

# ===== MAIL (Optional – for admin email notifications) =====
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=yourpassword
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="EuroMedStudy"

LOG_CHANNEL=stack
LOG_LEVEL=error
